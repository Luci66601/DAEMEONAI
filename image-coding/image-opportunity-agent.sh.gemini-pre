#!/usr/bin/env bash
. "${DAEMEONAI_HOME:-$HOME/daemeonai}/lib/central-openai-env.sh"
set -Eeuo pipefail

BASE="${DAEMEON_IMAGE_BASE:-${DAEMEONAI_HOME:-$HOME/daemeonai}/image-coding}"
GALLERY="$BASE/gallery"
RESULTS="$BASE/results"
OPP="$BASE/opportunities"
QUEUE="$BASE/queue"
WORK="$BASE/workspace"
SHEETS="$WORK/contact-sheets"
LOG="$BASE/logs/image-opportunity-agent.log"
MODEL="${OPENAI_MODEL:-gpt-5.6-luna}"
API_KEY="${OPENAI_API_KEY:-}"
TEST_MODE="${TEST_MODE:-}"

mkdir -p "$GALLERY" "$RESULTS" "$OPP" "$QUEUE" "$WORK" "$SHEETS" "$BASE/logs"

echo "=== DAEMEONAI IMAGE DISCOVERY v4 ===" | tee -a "$LOG"

# ------------------------------------------------------------
# 1. KERÄÄ GALLERIAN JPEG-KUVAT
# ------------------------------------------------------------

for source_dir in /sdcard/DCIM /sdcard/Pictures /sdcard/Download; do
    [[ -d "$source_dir" ]] || continue

    find "$source_dir" \
        -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' \) \
        -print0 2>/dev/null |
    while IFS= read -r -d '' f; do
        cp -n -- "$f" "$GALLERY/$(basename "$f")" 2>/dev/null || true
    done
done

mapfile -d '' IMAGES < <(
    find "$GALLERY" \
        -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' \) \
        -print0 2>/dev/null
)

echo "IMAGES=${#IMAGES[@]}" | tee -a "$LOG"

[[ ${#IMAGES[@]} -gt 0 ]] || exit 2

# ------------------------------------------------------------
# 2. LUO KONTAKTIKUVAT
# ------------------------------------------------------------

find "$SHEETS" -maxdepth 1 -type f -iname '*.jpg' -delete 2>/dev/null || true

if command -v montage >/dev/null 2>&1; then

    echo "CONTACT_SHEETS=ImageMagick" | tee -a "$LOG"

    mapfile -t SORTED < <(
        printf '%s\n' "${IMAGES[@]}" | sort
    )

    SHEET_N=0
    BATCH=()

    for IMG in "${SORTED[@]}"; do
        BATCH+=("$IMG")

        if [[ ${#BATCH[@]} -ge 12 ]]; then
            SHEET_N=$((SHEET_N + 1))

            montage "${BATCH[@]}" \
                -thumbnail '500x500>' \
                -geometry '+8+8' \
                -tile 4x3 \
                -background white \
                "$SHEETS/contact-$SHEET_N.jpg" \
                2>/dev/null || true

            BATCH=()
        fi
    done

    if [[ ${#BATCH[@]} -gt 0 ]]; then
        SHEET_N=$((SHEET_N + 1))

        montage "${BATCH[@]}" \
            -thumbnail '500x500>' \
            -geometry '+8+8' \
            -tile 4x3 \
            -background white \
            "$SHEETS/contact-$SHEET_N.jpg" \
            2>/dev/null || true
    fi

elif python3 - <<'PY'
try:
    import PIL
except Exception:
    raise SystemExit(1)
PY
then

    echo "CONTACT_SHEETS=Pillow" | tee -a "$LOG"

    python3 - "$GALLERY" "$SHEETS" <<'PY'
import math
import os
import sys

from PIL import Image, ImageDraw

gallery, outdir = sys.argv[1:]

files = sorted(
    os.path.join(gallery, name)
    for name in os.listdir(gallery)
    if name.lower().endswith((".jpg", ".jpeg"))
)

for start in range(0, len(files), 12):
    batch = files[start:start + 12]
    cell_w = 500
    cell_h = 500
    cols = 4
    rows = math.ceil(len(batch) / cols)

    sheet = Image.new("RGB", (cols * cell_w, rows * cell_h), "white")
    draw = ImageDraw.Draw(sheet)

    for index, path in enumerate(batch):
        try:
            with Image.open(path) as source:
                image = source.convert("RGB")
            image.thumbnail((480, 460))

            x = (index % cols) * cell_w + (cell_w - image.width) // 2
            y = (index // cols) * cell_h + 10

            sheet.paste(image, (x, y))
            draw.text(
                (x, y + image.height + 5),
                os.path.basename(path)[:55],
                fill="black",
            )
        except Exception:
            continue

    try:
        sheet.save(
            os.path.join(outdir, f"contact-{start // 12 + 1}.jpg"),
            "JPEG",
            quality=90,
        )
    except Exception:
        continue
PY

else
    echo "CONTACT_SHEET_ERROR=Install ImageMagick or Pillow" | tee -a "$LOG"
fi

mapfile -d '' SHEET_IMAGES < <(
    find "$SHEETS" -type f -iname '*.jpg' -print0 2>/dev/null
)

echo "CONTACT_SHEETS_COUNT=${#SHEET_IMAGES[@]}" | tee -a "$LOG"

# ------------------------------------------------------------
# 3. YKSITTÄISTEN KUVIEN ANALYYSI
# ------------------------------------------------------------

find "$RESULTS" -maxdepth 1 -type f -name 'discovery-*.json' -delete 2>/dev/null || true

N=0

for IMG in "${IMAGES[@]}"; do
    N=$((N + 1))
    NAME="$(basename "$IMG")"
    OUT="$RESULTS/discovery-$N.json"

    echo "[$N/${#IMAGES[@]}] $NAME" | tee -a "$LOG"

    python3 - "$IMG" "$OUT" "$MODEL" "$API_KEY" "$TEST_MODE" <<'PY'
import base64
import datetime
import json
import os
import sys
import urllib.request

img, out, model, key, test_mode = sys.argv[1:]
test_enabled = str(test_mode).strip().lower() in {
    "1", "true", "yes", "on"
}

with open(img, "rb") as handle:
    encoded = base64.b64encode(handle.read()).decode("ascii")

stat = os.stat(img)
metadata = {
    "filename": os.path.basename(img),
    "size_bytes": stat.st_size,
    "modified": datetime.datetime.fromtimestamp(
        stat.st_mtime
    ).isoformat(),
}

prompt = """You are DaemeonAI's visual discovery agent.

Analyze this image as a possible source of a technical idea.

Do NOT require visible source code.

Inspect:
applications,
Android UI,
Termux,
terminals,
files,
folders,
buttons,
errors,
configuration,
text,
websites,
diagrams,
devices,
development tools,
automation,
and anything that could suggest software work.

Return JSON ONLY:

{
 "summary": "...",
 "visual_type": "...",
 "technical_clues": [],
 "visible_text": [],
 "possible_software_task": "...",
 "possible_language": "...",
 "potential": 0.0,
 "needs_more_investigation": true
}

Use potential 0.0-1.0.
Do not invent commands, paths, credentials or code."""

result = {"source": metadata}

if test_enabled:
    result["analysis"] = {
        "test_mode": True,
        "summary": "External image analysis was skipped in TEST_MODE.",
        "potential": 0.0,
        "needs_more_investigation": True,
    }
elif not key:
    result["error"] = "OPENAI_API_KEY is not set"
else:
    payload = {
        "model": model,
        "input": [{
            "role": "user",
            "content": [
                {
                    "type": "input_text",
                    "text": prompt + "\n\nFILE METADATA:\n" +
                    json.dumps(metadata, ensure_ascii=False),
                },
                {
                    "type": "input_image",
                    "image_url": "data:image/jpeg;base64," + encoded,
                    "detail": "high",
                },
            ],
        }],
    }

    try:
        request = urllib.request.Request(
            "https://api.openai.com/v1/responses",
            data=json.dumps(payload).encode("utf-8"),
            headers={
                "Authorization": "Bearer " + key,
                "Content-Type": "application/json",
            },
        )

        with urllib.request.urlopen(request, timeout=180) as response:
            api_response = json.load(response)

        text = str(api_response.get("output_text", "")).strip()

        if not text:
            parts = []
            for item in api_response.get("output", []) or []:
                for content in item.get("content", []) or []:
                    if isinstance(content, dict) and content.get("text"):
                        parts.append(str(content["text"]))
            text = "\n".join(parts).strip()

        try:
            result["analysis"] = json.loads(text)
        except Exception:
            result["analysis"] = {
                "parse_error": True,
                "raw_output": text,
            }

    except Exception as error:
        result["error"] = str(error)

with open(out, "w", encoding="utf-8") as handle:
    json.dump(result, handle, ensure_ascii=False, indent=2)
PY
done

# ------------------------------------------------------------
# 4. ANALYSOI YHDISTETYT KONTAKTIKUVAT
# ------------------------------------------------------------

find "$RESULTS" -maxdepth 1 -type f -name 'combined-*.json' -delete 2>/dev/null || true

SN=0

for SHEET in "${SHEET_IMAGES[@]}"; do
    SN=$((SN + 1))
    OUT="$RESULTS/combined-$SN.json"

    echo "[COMBINED $SN/${#SHEET_IMAGES[@]}] $(basename "$SHEET")" |
        tee -a "$LOG"

    python3 - "$SHEET" "$OUT" "$MODEL" "$API_KEY" "$TEST_MODE" <<'PY'
import base64
import json
import os
import sys
import urllib.request

img, out, model, key, test_mode = sys.argv[1:]
test_enabled = str(test_mode).strip().lower() in {
    "1", "true", "yes", "on"
}

with open(img, "rb") as handle:
    encoded = base64.b64encode(handle.read()).decode("ascii")

prompt = """You are DaemeonAI's MULTI-IMAGE correlation agent.

This image is a contact sheet containing several gallery images.

Analyze the images TOGETHER.

Look for relationships between images:
- same application
- same project
- same terminal
- same error
- same codebase
- before/after states
- repeated configuration
- workflow sequences
- screenshots belonging to one technical problem
- multiple pieces that could form one larger technical task

The images may individually look unrelated but collectively reveal a task.

Return JSON ONLY:

{
 "relationship_found": true,
 "group_summary": "...",
 "related_elements": [],
 "possible_project": "...",
 "possible_problem": "...",
 "possible_software_task": "...",
 "likely_language": "...",
 "confidence": 0.0
}

Do not invent code, paths, credentials or system state."""

if test_enabled:
    analysis = {
        "test_mode": True,
        "relationship_found": False,
        "group_summary": "External contact-sheet analysis was skipped in TEST_MODE.",
        "confidence": 0.0,
    }
elif not key:
    analysis = {"api_error": "OPENAI_API_KEY is not set"}
else:
    payload = {
        "model": model,
        "input": [{
            "role": "user",
            "content": [
                {"type": "input_text", "text": prompt},
                {
                    "type": "input_image",
                    "image_url": "data:image/jpeg;base64," + encoded,
                    "detail": "high",
                },
            ],
        }],
    }

    try:
        request = urllib.request.Request(
            "https://api.openai.com/v1/responses",
            data=json.dumps(payload).encode("utf-8"),
            headers={
                "Authorization": "Bearer " + key,
                "Content-Type": "application/json",
            },
        )

        with urllib.request.urlopen(request, timeout=180) as response:
            api_response = json.load(response)

        text = str(api_response.get("output_text", "")).strip()

        if not text:
            parts = []
            for item in api_response.get("output", []) or []:
                for content in item.get("content", []) or []:
                    if isinstance(content, dict) and content.get("text"):
                        parts.append(str(content["text"]))
            text = "\n".join(parts).strip()

        try:
            analysis = json.loads(text)
        except Exception:
            analysis = {
                "parse_error": True,
                "raw_output": text,
            }

    except Exception as error:
        analysis = {"api_error": str(error)}

with open(out, "w", encoding="utf-8") as handle:
    json.dump(
        {
            "contact_sheet": img,
            "analysis": analysis,
        },
        handle,
        ensure_ascii=False,
        indent=2,
    )
PY
done

# ------------------------------------------------------------
# 5. YHDISTÄ YKSITTÄISET + KONTAKTIKUVAT
# ------------------------------------------------------------

echo "=== SYNTHESIS ===" | tee -a "$LOG"

python3 - "$RESULTS" "$OPP/potential-opportunity.json" "$MODEL" "$API_KEY" "$TEST_MODE" <<'PY'
import datetime
import json
import os
import sys
import urllib.request

results, out, model, key, test_mode = sys.argv[1:]
test_enabled = str(test_mode).strip().lower() in {
    "1", "true", "yes", "on"
}

evidence = []

for name in sorted(os.listdir(results)):
    if not (
        name.startswith("discovery-") or
        name.startswith("combined-")
    ):
        continue
    if not name.endswith(".json"):
        continue

    path = os.path.join(results, name)
    try:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
        evidence.append({
            "source_file": name,
            "analysis": data.get("analysis", {}),
        })
    except Exception:
        continue

prompt = """You are DaemeonAI's final technical opportunity synthesis agent.

You receive:
1. individual image observations
2. multi-image contact-sheet observations

Find a concrete software-development opportunity that can reasonably
be investigated.

IMPORTANT:
- Combine evidence across images.
- A useful opportunity does NOT require visible source code.
- Filenames and visual context can establish relationships.
- Contact-sheet observations are especially important.
- Do not invent missing technical facts.
- Do not execute anything.
- Do not modify files.
- Do not make payments.
- This output is only a proposal.

Return JSON ONLY:

{
 "opportunity_found": true,
 "title": "...",
 "problem": "...",
 "why_the_images_are_related": "...",
 "evidence": [],
 "related_images": [],
 "proposed_task": "...",
 "language": "...",
 "workspace": "...",
 "test_plan": "...",
 "confidence": 0.0
}

If the evidence is genuinely insufficient:
opportunity_found=false.

EVIDENCE:
""" + json.dumps(evidence, ensure_ascii=False, indent=2)

if test_enabled:
    final = {
        "opportunity_found": False,
        "test_mode": True,
        "reason": "External synthesis was skipped in TEST_MODE.",
    }
elif not key:
    final = {
        "opportunity_found": False,
        "api_error": "OPENAI_API_KEY is not set",
    }
else:
    payload = {
        "model": model,
        "input": [{
            "role": "user",
            "content": [{
                "type": "input_text",
                "text": prompt,
            }],
        }],
    }

    try:
        request = urllib.request.Request(
            "https://api.openai.com/v1/responses",
            data=json.dumps(payload).encode("utf-8"),
            headers={
                "Authorization": "Bearer " + key,
                "Content-Type": "application/json",
            },
        )

        with urllib.request.urlopen(request, timeout=180) as response:
            api_response = json.load(response)

        text = str(api_response.get("output_text", "")).strip()

        if not text:
            parts = []
            for item in api_response.get("output", []) or []:
                for content in item.get("content", []) or []:
                    if isinstance(content, dict) and content.get("text"):
                        parts.append(str(content["text"]))
            text = "\n".join(parts).strip()

        try:
            final = json.loads(text)
        except Exception:
            final = {
                "opportunity_found": False,
                "parse_error": True,
                "raw_response": text,
            }

    except Exception as error:
        final = {
            "opportunity_found": False,
            "api_error": str(error),
        }

final["generated_at"] = datetime.datetime.now().isoformat()
final["model"] = model
final["evidence_items"] = len(evidence)
final["contact_sheets"] = len([
    name for name in os.listdir(results)
    if name.startswith("combined-") and name.endswith(".json")
])

with open(out, "w", encoding="utf-8") as handle:
    json.dump(final, handle, ensure_ascii=False, indent=2)

print(json.dumps(final, ensure_ascii=False, indent=2))
PY

# ------------------------------------------------------------
# 6. MUODOSTA HYVÄKSYNTÄJONO
# ------------------------------------------------------------

if python3 - "$OPP/potential-opportunity.json" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    data = json.load(handle)

raise SystemExit(0 if data.get("opportunity_found") is True else 1)
PY
then
    TS="$(date +%Y%m%d-%H%M%S)"
    Q="$QUEUE/image-opportunity-$TS.json"

    python3 - "$OPP/potential-opportunity.json" "$Q" <<'PY'
import json
import sys

src, dst = sys.argv[1:]

with open(src, encoding="utf-8") as handle:
    opportunity = json.load(handle)

queue = {
    "operation": "IMAGE_OPPORTUNITY",
    "status": "PENDING_APPROVAL",
    "human_approval_required": True,
    "execution_allowed": False,
    "write_allowed": False,
    "payment_execution": False,
    "source": "gallery+combined_images",
    "opportunity": opportunity,
}

with open(dst, "w", encoding="utf-8") as handle:
    json.dump(queue, handle, ensure_ascii=False, indent=2)

print("QUEUED=" + dst)
PY
else
    echo "NO_OPPORTUNITY"
fi

echo "=== DISCOVERY COMPLETE ==="
